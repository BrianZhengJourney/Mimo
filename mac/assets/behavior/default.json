{
  "schemaVersion": 2,

  "_comment": [
    "Default behavior pack. Every generated familiar falls back to this until",
    "it ships its own.",
    "",
    "A pose may name an installed action strip. Missing strips fall back to the",
    "familiar's standing art, so this pack also works for older generated pets.",
    "Walk and gaze remain runtime-driven because they key frames to distance and",
    "cursor angle; rest and wall are ordinary strip-authored behaviors.",
    "",
    "Durations are seconds and velocities are px/second. Shimeji counts ticks,",
    "which bakes its 25fps into every pack.",
    "",
    "The quiet set is not decoration: D6 says the companion stays silent during",
    "deep work. That is expressed as a condition on mimo.mood, not as a global",
    "if — same shape as Shimeji's environment gating, over Mimo's semantic layer."
  ],

  "actions": [
    {
      "name": "Stand",
      "type": "stay",
      "requires": "grounded",
      "duration": "${1.5 + random() * 3}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 2.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "LookAround",
      "type": "stay",
      "requires": "grounded",
      "duration": "${2 + random() * 2}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 1.4, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "Sit",
      "type": "stay",
      "requires": "grounded",
      "duration": "${4 + random() * 8}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 2.5, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "WalkLeft",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.left + 80 + random() * 220}",
      "duration": "${3 + random() * 5}",
      "animations": [
        { "poses": [
          { "frame": 0, "hold": 0.24, "velocity": [-64, 0] },
          { "frame": 0, "hold": 0.24, "velocity": [-64, 0] }
        ] }
      ]
    },
    {
      "name": "WalkRight",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.right - 80 - random() * 220}",
      "duration": "${3 + random() * 5}",
      "animations": [
        { "poses": [
          { "frame": 0, "hold": 0.24, "velocity": [64, 0] },
          { "frame": 0, "hold": 0.24, "velocity": [64, 0] }
        ] }
      ]
    },
    {
      "name": "Wander",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.left + 60 + random() * (world.display.workArea.right - world.display.workArea.left - 120)}",
      "duration": "${4 + random() * 6}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 0.26, "velocity": [58, 0] } ] }
      ]
    },

    {
      "name": "QuietBreathe",
      "type": "stay",
      "requires": "grounded",
      "duration": "${8 + random() * 14}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 3.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "GlanceAtYou",
      "type": "stay",
      "requires": "grounded",
      "duration": "${1 + random() * 1.5}",
      "animations": [
        { "poses": [ { "frame": 1, "hold": 1.2, "velocity": [0, 0] } ] }
      ]
    },

    {
      "name": "Slump",
      "type": "stay",
      "requires": "grounded",
      "duration": "${5 + random() * 6}",
      "animations": [
        { "poses": [ { "frame": 2, "hold": 2.2, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "CelebrateSmall",
      "type": "stay",
      "requires": "grounded",
      "duration": 2.4,
      "animations": [
        { "poses": [
          { "frame": 1, "hold": 0.8, "velocity": [0, 0] },
          { "frame": 0, "hold": 1.6, "velocity": [0, 0] }
        ] }
      ]
    },
    {
      "name": "SoftNudge",
      "type": "stay",
      "requires": "grounded",
      "duration": 1.8,
      "animations": [
        { "poses": [
          { "frame": 0, "hold": 0.9, "velocity": [0, 0] },
          { "frame": 1, "hold": 0.9, "velocity": [0, 0] }
        ] }
      ]
    },
    {
      "name": "ReflectTogether",
      "type": "stay",
      "requires": "grounded",
      "duration": 8,
      "animations": [
        { "poses": [ { "frame": 0, "hold": 4, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "FatiguePause",
      "type": "stay",
      "requires": "grounded",
      "duration": 10,
      "animations": [
        { "poses": [ { "frame": 0, "hold": 5, "velocity": [0, 0] } ] }
      ]
    },

    {
      "name": "Poked",
      "type": "stay",
      "requires": "grounded",
      "duration": "${0.8 + random() * 0.4}",
      "animations": [
        { "poses": [ { "frame": 1, "hold": 1.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "RestSettle",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 0, "hold": 0.55 },
          { "strip": "rest", "frame": 1, "hold": 0.65 },
          { "strip": "rest", "frame": 2, "hold": 0.95 }
        ] }
      ]
    },
    {
      "name": "RestSleep",
      "type": "stay",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 3, "hold": 1.40 },
          { "strip": "rest", "frame": 4, "hold": 1.20 },
          { "strip": "rest", "frame": 5, "hold": 1.60 }
        ] }
      ]
    },
    {
      "name": "PlayTennis",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "tennis", "frame": 0, "hold": 0.42 },
          { "strip": "tennis", "frame": 1, "hold": 0.32 },
          { "strip": "tennis", "frame": 2, "hold": 0.24 },
          { "strip": "tennis", "frame": 3, "hold": 0.18 },
          { "strip": "tennis", "frame": 4, "hold": 0.16 },
          { "strip": "tennis", "frame": 5, "hold": 0.26 },
          { "strip": "tennis", "frame": 6, "hold": 0.34 },
          { "strip": "tennis", "frame": 7, "hold": 0.42 },
          { "strip": "tennis", "frame": 8, "hold": 0.62 }
        ] }
      ]
    },
    {
      "name": "ClingWall",
      "type": "stay",
      "requires": "attached",
      "duration": "${2.5 + random() * 2.5}",
      "animations": [
        { "poses": [
          { "strip": "wall", "frame": 0, "hold": 0.95 },
          { "strip": "wall", "frame": 1, "hold": 0.85 },
          { "strip": "wall", "frame": 2, "hold": 1.25 }
        ] }
      ]
    },
    {
      "name": "SitAtWall",
      "type": "stay",
      "requires": "attached",
      "duration": "${2.5 + random() * 3.5}",
      "animations": [
        { "poses": [
          { "strip": "wall", "frame": 3, "hold": 1.00 },
          { "strip": "wall", "frame": 4, "hold": 0.85 },
          { "strip": "wall", "frame": 5, "hold": 1.25 }
        ] }
      ]
    },

    { "name": "Fall",    "type": "embedded", "requires": "airborne", "impl": "fall" },
    { "name": "Dragged", "type": "embedded", "requires": "held",     "impl": "dragged" },
    { "name": "Thrown",  "type": "embedded", "requires": "airborne", "impl": "thrown" }
  ],

  "_reactions_comment": [
    "Events the runtime raises, mapped to behaviors. 'click' fires on a press",
    "that never became a drag: the companion is interrupted mid-behavior and",
    "runs the reaction instead of opening app UI. Omit an event to get the",
    "app's default handling back."
  ],
  "reactions": {
    "click": "Poked",
    "focusComplete": "PlayTennis",
    "focusCompleteFallback": "CelebrateSmall",
    "distractionLoop": "SoftNudge",
    "journalOpened": "ReflectTogether",
    "fatigue": "FatiguePause"
  },

  "behaviors": [
    {
      "name": "Stand",
      "frequency": 100,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": true, "refs": [
        { "name": "LookAround", "frequency": 40 },
        { "name": "Sit",        "frequency": 25 },
        { "name": "RestSettle", "frequency": 7 }
      ] }
    },
    {
      "name": "LookAround",
      "frequency": 40,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand",  "frequency": 40 }
      ] }
    },
    {
      "name": "WalkLeft",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand", "frequency": 80 },
        { "name": "Sit",   "frequency": 30 }
      ] }
    },
    {
      "name": "WalkRight",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand", "frequency": 80 },
        { "name": "Sit",   "frequency": 30 }
      ] }
    },
    {
      "name": "Wander",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand",      "frequency": 70 },
        { "name": "LookAround", "frequency": 30 }
      ] }
    },

    {
      "name": "Sit",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": false, "refs": [
        { "name": "Sit",   "frequency": 100 },
        { "name": "Stand", "frequency": 6 }
      ] }
    },
    {
      "name": "RestSettle",
      "frequency": 9,
      "when": "#{self.state == 'grounded' && mimo.mood == 'idle'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 100 }
      ] }
    },
    {
      "name": "RestSleep",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 100 }
      ] }
    },
    {
      "name": "PlayTennis",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && (mimo.mood == 'idle' || mimo.mood == 'focused' || mimo.mood == 'scholar' || mimo.mood == 'deepWork')}",
      "next": { "additive": false, "refs": [
        { "name": "Stand", "frequency": 100 }
      ] }
    },

    {
      "name": "QuietBreathe",
      "frequency": 300,
      "when": "#{self.state == 'grounded' && (mimo.mood == 'focusSession' || mimo.mood == 'deepWork' || mimo.mood == 'focused' || mimo.mood == 'scholar')}",
      "next": { "additive": true, "refs": [
        { "name": "QuietBreathe", "frequency": 100 },
        { "name": "GlanceAtYou",  "frequency": 8 }
      ] }
    },
    {
      "name": "GlanceAtYou",
      "frequency": 0,
      "when": "#{self.state == 'grounded' && (mimo.mood == 'focusSession' || mimo.mood == 'deepWork' || mimo.mood == 'focused' || mimo.mood == 'scholar')}",
      "next": { "additive": false, "refs": [
        { "name": "QuietBreathe", "frequency": 100 }
      ] }
    },

    {
      "name": "Reflecting",
      "action": "ReflectTogether",
      "frequency": 300,
      "when": "#{self.state == 'grounded' && mimo.mood == 'reflecting'}",
      "next": { "additive": false, "refs": [
        { "name": "Reflecting", "frequency": 100 }
      ] }
    },

    {
      "name": "Slump",
      "frequency": 200,
      "when": "#{self.state == 'grounded' && (mimo.mood == 'poisoned' || mimo.mood == 'dizzy' || mimo.mood == 'ghost')}",
      "next": { "additive": true, "refs": [
        { "name": "Slump", "frequency": 100 }
      ] }
    },
    {
      "name": "CelebrateSmall",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },
    {
      "name": "SoftNudge",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },
    {
      "name": "ReflectTogether",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },
    {
      "name": "FatiguePause",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },

    {
      "name": "Poked",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },

    {
      "name": "ClingWall",
      "frequency": 100,
      "when": "#{self.state == 'attached' && self.surface == 'wall'}",
      "_comment": "additive:false with no refs = after clinging, select nothing — which the runtime reads as letting go. additive:true would re-draw ClingWall from the pool forever.",
      "next": { "additive": false, "refs": [] }
    },
    {
      "name": "SitAtWall",
      "frequency": 60,
      "when": "#{self.state == 'attached' && self.surface == 'wall'}",
      "next": { "additive": false, "refs": [] }
    }
  ]
}
