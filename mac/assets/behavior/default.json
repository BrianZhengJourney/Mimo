{
  "schemaVersion": 2,

  "_comment": [
    "Default behavior pack. Every generated familiar falls back to this until",
    "it ships its own.",
    "",
    "A pose may name an installed action strip. Missing strips fall back to the",
    "familiar's standing art, so this pack also works for older generated pets.",
    "Walk and gaze remain runtime-driven because they key frames to distance and",
    "cursor angle; rest and wall are ordinary strip-authored behaviors.",
    "",
    "Durations are seconds and velocities are px/second. Shimeji counts ticks,",
    "which bakes its 25fps into every pack.",
    "",
    "The quiet set is not decoration: D6 says the companion stays silent during",
    "deep work. That is expressed as a condition on mimo.mood, not as a global",
    "if — same shape as Shimeji's environment gating, over Mimo's semantic layer."
  ],

  "actions": [
    {
      "name": "Stand",
      "type": "stay",
      "requires": "grounded",
      "duration": "${1.5 + random() * 3}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 2.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "LookAround",
      "type": "stay",
      "requires": "grounded",
      "duration": "${2 + random() * 2}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 1.4, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "Sit",
      "type": "stay",
      "requires": "grounded",
      "duration": "${4 + random() * 8}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 2.5, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "WalkLeft",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.left + 80 + random() * 220}",
      "duration": "${3 + random() * 5}",
      "animations": [
        { "poses": [
          { "frame": 0, "hold": 0.18, "velocity": [-88, 0] },
          { "frame": 0, "hold": 0.18, "velocity": [-88, 0] }
        ] }
      ]
    },
    {
      "name": "WalkRight",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.right - 80 - random() * 220}",
      "duration": "${3 + random() * 5}",
      "animations": [
        { "poses": [
          { "frame": 0, "hold": 0.18, "velocity": [88, 0] },
          { "frame": 0, "hold": 0.18, "velocity": [88, 0] }
        ] }
      ]
    },
    {
      "name": "Wander",
      "type": "move",
      "requires": "grounded",
      "targetX": "${world.display.workArea.left + 60 + random() * (world.display.workArea.right - world.display.workArea.left - 120)}",
      "duration": "${4 + random() * 6}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 0.2, "velocity": [72, 0] } ] }
      ]
    },

    {
      "name": "QuietBreathe",
      "type": "stay",
      "requires": "grounded",
      "duration": "${8 + random() * 14}",
      "animations": [
        { "poses": [ { "frame": 0, "hold": 3.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "GlanceAtYou",
      "type": "stay",
      "requires": "grounded",
      "duration": "${1 + random() * 1.5}",
      "animations": [
        { "poses": [ { "frame": 1, "hold": 1.2, "velocity": [0, 0] } ] }
      ]
    },

    {
      "name": "Slump",
      "type": "stay",
      "requires": "grounded",
      "duration": "${5 + random() * 6}",
      "animations": [
        { "poses": [ { "frame": 2, "hold": 2.2, "velocity": [0, 0] } ] }
      ]
    },

    {
      "name": "Poked",
      "type": "stay",
      "requires": "grounded",
      "duration": "${0.8 + random() * 0.4}",
      "animations": [
        { "poses": [ { "frame": 1, "hold": 1.0, "velocity": [0, 0] } ] }
      ]
    },
    {
      "name": "RestSettle",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 0, "hold": 0.30 },
          { "strip": "rest", "frame": 1, "hold": 0.24 },
          { "strip": "rest", "frame": 2, "hold": 0.24 },
          { "strip": "rest", "frame": 3, "hold": 0.28 },
          { "strip": "rest", "frame": 4, "hold": 0.32 },
          { "strip": "rest", "frame": 5, "hold": 0.55 }
        ] }
      ]
    },
    {
      "name": "RestSleep",
      "type": "stay",
      "requires": "grounded",
      "duration": "${7 + random() * 8}",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 5,  "hold": 0.85 },
          { "strip": "rest", "frame": 6,  "hold": 0.85 },
          { "strip": "rest", "frame": 7,  "hold": 0.85 },
          { "strip": "rest", "frame": 8,  "hold": 0.85 },
          { "strip": "rest", "frame": 9,  "hold": 0.85 },
          { "strip": "rest", "frame": 10, "hold": 0.85 }
        ] }
      ]
    },
    {
      "name": "RestDream",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 11, "hold": 0.65 },
          { "strip": "rest", "frame": 12, "hold": 1.10 },
          { "strip": "rest", "frame": 11, "hold": 0.65 }
        ] }
      ]
    },
    {
      "name": "RestStir",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 13, "hold": 0.30 },
          { "strip": "rest", "frame": 14, "hold": 0.32 },
          { "strip": "rest", "frame": 15, "hold": 0.55 },
          { "strip": "rest", "frame": 14, "hold": 0.30 },
          { "strip": "rest", "frame": 13, "hold": 0.30 }
        ] }
      ]
    },
    {
      "name": "RestRise",
      "type": "animate",
      "requires": "grounded",
      "animations": [
        { "poses": [
          { "strip": "rest", "frame": 10, "hold": 0.20 },
          { "strip": "rest", "frame": 8,  "hold": 0.18 },
          { "strip": "rest", "frame": 6,  "hold": 0.18 },
          { "strip": "rest", "frame": 5,  "hold": 0.20 },
          { "strip": "rest", "frame": 4,  "hold": 0.22 },
          { "strip": "rest", "frame": 3,  "hold": 0.22 },
          { "strip": "rest", "frame": 2,  "hold": 0.22 },
          { "strip": "rest", "frame": 1,  "hold": 0.22 },
          { "strip": "rest", "frame": 0,  "hold": 0.30 }
        ] }
      ]
    },
    {
      "name": "ClingWall",
      "type": "stay",
      "requires": "attached",
      "duration": "${2.5 + random() * 2.5}",
      "animations": [
        { "poses": [
          { "strip": "wall", "frame": 0, "hold": 0.38 },
          { "strip": "wall", "frame": 1, "hold": 0.38 },
          { "strip": "wall", "frame": 2, "hold": 0.38 },
          { "strip": "wall", "frame": 3, "hold": 0.38 },
          { "strip": "wall", "frame": 4, "hold": 0.38 },
          { "strip": "wall", "frame": 5, "hold": 0.38 },
          { "strip": "wall", "frame": 6, "hold": 0.38 },
          { "strip": "wall", "frame": 7, "hold": 0.38 }
        ] }
      ]
    },

    { "name": "Fall",    "type": "embedded", "requires": "airborne", "impl": "fall" },
    { "name": "Dragged", "type": "embedded", "requires": "held",     "impl": "dragged" },
    { "name": "Thrown",  "type": "embedded", "requires": "airborne", "impl": "thrown" }
  ],

  "_reactions_comment": [
    "Events the runtime raises, mapped to behaviors. 'click' fires on a press",
    "that never became a drag: the companion is interrupted mid-behavior and",
    "runs the reaction instead of opening app UI. Omit an event to get the",
    "app's default handling back."
  ],
  "reactions": { "click": "Poked" },

  "behaviors": [
    {
      "name": "Stand",
      "frequency": 100,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "WalkLeft",   "frequency": 60 },
        { "name": "WalkRight",  "frequency": 60 },
        { "name": "LookAround", "frequency": 40 },
        { "name": "Sit",        "frequency": 35 }
      ] }
    },
    {
      "name": "LookAround",
      "frequency": 40,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "Wander", "frequency": 70 },
        { "name": "Stand",  "frequency": 40 }
      ] }
    },
    {
      "name": "WalkLeft",
      "frequency": 45,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand", "frequency": 80 },
        { "name": "Sit",   "frequency": 30 }
      ] }
    },
    {
      "name": "WalkRight",
      "frequency": 45,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand", "frequency": 80 },
        { "name": "Sit",   "frequency": 30 }
      ] }
    },
    {
      "name": "Wander",
      "frequency": 30,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "Stand",      "frequency": 70 },
        { "name": "LookAround", "frequency": 30 }
      ] }
    },

    {
      "name": "Sit",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "Sit",   "frequency": 100 },
        { "name": "Stand", "frequency": 6 }
      ] }
    },
    {
      "name": "RestSettle",
      "frequency": 18,
      "when": "#{self.state == 'grounded' && mimo.mood != 'deepWork'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 100 }
      ] }
    },
    {
      "name": "RestSleep",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 72 },
        { "name": "RestDream", "frequency": 14 },
        { "name": "RestStir",  "frequency": 9 },
        { "name": "RestRise",  "frequency": 5 }
      ] }
    },
    {
      "name": "RestDream",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 100 }
      ] }
    },
    {
      "name": "RestStir",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "RestSleep", "frequency": 100 }
      ] }
    },
    {
      "name": "RestRise",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "Stand", "frequency": 100 }
      ] }
    },

    {
      "name": "QuietBreathe",
      "frequency": 300,
      "when": "#{self.state == 'grounded' && mimo.mood == 'deepWork'}",
      "next": { "additive": true, "refs": [
        { "name": "QuietBreathe", "frequency": 100 },
        { "name": "GlanceAtYou",  "frequency": 8 }
      ] }
    },
    {
      "name": "GlanceAtYou",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": false, "refs": [
        { "name": "QuietBreathe", "frequency": 100 }
      ] }
    },

    {
      "name": "Slump",
      "frequency": 200,
      "when": "#{self.state == 'grounded' && (mimo.mood == 'poisoned' || mimo.mood == 'dizzy')}",
      "next": { "additive": true, "refs": [
        { "name": "Slump", "frequency": 100 }
      ] }
    },

    {
      "name": "Poked",
      "frequency": 0,
      "when": "#{self.state == 'grounded'}",
      "next": { "additive": true, "refs": [] }
    },

    {
      "name": "ClingWall",
      "frequency": 100,
      "when": "#{self.state == 'attached' && self.surface == 'wall'}",
      "_comment": "additive:false with no refs = after clinging, select nothing — which the runtime reads as letting go. additive:true would re-draw ClingWall from the pool forever.",
      "next": { "additive": false, "refs": [] }
    }
  ]
}
